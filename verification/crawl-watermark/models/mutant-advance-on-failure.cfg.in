\* Broken on purpose: the watermark advances even when a listed PR failed to save.
\* @...@ values are read from the code by check.sh.
SPECIFICATION Spec
CONSTANTS
    PRs = {1, 2}
    MaxTime = 2
    MaxUpdates = 2
    MaxFails = 1
    MaxHourly = 2
    Workers = 1
    StopInclusive = @StopInclusive@
    AdvanceNeedsAllSaved = FALSE
    TargetedNeverAdvances = @TargetedNeverAdvances@
    SaveGuard = @SaveGuard@
    SameSecondUpdates = FALSE
    WithRepoAdd = FALSE
    WithPageRefresh = FALSE
    PartialListing = FALSE
INVARIANTS TypeOK Converged
